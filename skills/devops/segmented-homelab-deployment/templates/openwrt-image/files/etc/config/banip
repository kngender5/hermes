config banip 'global'
	option ban_enabled '1'
	option ban_autodetect '0'
	option ban_ifaces 'wan'
	option ban_proto4_enabled '1'
	option ban_proto6_enabled '0'
	option ban_nftpolicy 'memory'
	option ban_nftpriority '299'
	option ban_nftlimit '65535'
	option ban_fetchcmd 'uclient-fetch --no-check-certificate --timeout=20 --tries=3 --quiet'
	option ban_loglimit '100'
	option ban_debug '0'
	option ban_deduplicate '1'
	option ban_autoblocklist 'allowlist'
	list ban_feeds 'doh'
	list ban_feeds 'tor'
	list ban_feeds 'threatstop'

config banip 'report'
	option ban_mailreport '0'
	option ban_reportdir '/tmp'
